DATABASE_URL=postgresql+psycopg://lectio:lectio@localhost:5432/lectio
REDIS_URL=redis://localhost:6379/0
DEBUG=true
SQL_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# true only behind HTTPS.
REFRESH_COOKIE_SECURE=false

STORAGE_DIR=storage
# local keeps files in STORAGE_DIR; s3 moves finished videos, previews and
# avatars to a bucket (MinIO from compose.yaml) and serves signed links.
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
# Address browsers use to reach the bucket, if different from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=lectio
S3_SECRET_KEY=lectio-secret
S3_BUCKET=lectio
# CORS_ORIGINS=["http://localhost:5173"]

# auto picks cuda, then mps (Apple Silicon), then cpu.
DEVICE=auto
PRELOAD_MODELS=true
RELEASE_MODELS_BETWEEN_STAGES=true

# Linux + NVIDIA: faster_whisper. macOS on Apple Silicon: mlx.
WHISPER_BACKEND=faster_whisper
WHISPER_MODEL=large-v3-turbo
# default lets CTranslate2 choose; int8_float16 saves VRAM on small cards.
WHISPER_COMPUTE_TYPE=int8_float16
# 4 fits a 6 GB card next to the API; raise it on bigger GPUs.
WHISPER_BATCH_SIZE=4
# Empty means autodetect per lecture.
WHISPER_LANGUAGE=

EMBEDDING_MODEL=BAAI/bge-m3
# Indexing in the worker.
# EMBEDDING_DEVICE=cuda
# Search queries in the API: cpu costs ~40 ms per query and leaves the
# GPU to the LLM, which then runs about twice as fast on a 6 GB card.
SEARCH_DEVICE=cpu
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Any OpenAI-compatible endpoint: Ollama, LM Studio, vLLM, OpenRouter, OpenAI.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_PART_CHARS=9000
# true for hybrid reasoning models such as qwen3:8b.
LLM_NO_THINK=false

# Telegram bot (python -m lectio.bot): token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The web app's address, for links in bot messages.
PUBLIC_WEB_URL=http://localhost:5173
